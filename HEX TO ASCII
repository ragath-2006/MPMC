.ORG 8000H
START:
        MOV DPTR,#9000H
        MOVX A,@DPTR
        MOV R0,A
        ANL A,#0F0H
        SWAP A
        CJNE A,#0AH,L1
L1:     JC L2
        ADD A,#07H
L2:     ADD A,#30H
        INC DPTR
        MOVX @DPTR,A
        MOV A,R0
        ANL A,#0FH
        CJNE A,#0AH,L3
L3:     JC L4
        ADD A,#07H
L4:     ADD A,#30H
        INC DPTR
        MOVX @DPTR,A
        RET
END
