	OUTPUT 2500AD
.ORG 2000H
DATA SEGMENT
STRING1 DB "BUBBLE"
KEY DB 'O'
RESULT DB 00H
COUNT EQU 06H
DATA ENDS
CODE SEGMENT
	ASSUME CS:CODE,DS:DATA,ES:DATA
	MOV AX,DATA
	MOV DS, AX
	MOV ES,AX
	MOV CL,COUNT
	LEA DI,STRING1
	MOV AL,KEY
L2:	SCASB
	JNZ L1
	MOV RESULT,01H
	JMP L3
L1:	MOV RESULT,01H
	INC DI
	DEC CL
	JNZ L2
	MOV RESULT,00H
L3:	HLT
CODE ENDS
END

