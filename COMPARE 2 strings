	OUTPUT 2500AD
.ORG 2000H
DATA SEGMENT
STRING1 DB "CHERRY"
STRING2 DB "BUBBLU"
RESULT DB 00H
COUNT EQU 05H
DATA ENDS
CODE SEGMENT
	ASSUME CS:CODE,DS:DATA,ES:DATA
	MOV AX,DATA
	MOV DS,AX
	MOV ES,AX
	MOV CL,COUNT
	LEA SI,STRING1
	LEA DI,STRING2
	CLD
L2:	CMPSB
	JZ L1
	JMP L3
L1:	MOV RESULT,01H
	DEC CL
	JNZ L2
L3:	HLT
CODE ENDS
END
